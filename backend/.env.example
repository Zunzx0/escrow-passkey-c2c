# PostgreSQL connection (native install, no Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace?schema=public"

PORT=4000

# WebAuthn / Passkey
RP_ID=localhost
RP_NAME="Escrow Passkey Marketplace"
ORIGIN=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173

# Session cookie (password login and Passkey login both create this same session type)
SESSION_COOKIE_NAME=session_token
SESSION_TTL_DAYS=7
SESSION_COOKIE_SECURE=false

# WebAuthn challenges: random, single-use, expiring, rate-limited per user+IP
AUTH_CHALLENGE_TTL_MINUTES=5
CHALLENGE_RATE_LIMIT_MAX=10
CHALLENGE_RATE_LIMIT_WINDOW_MINUTES=10

# reauth_grant: short-lived, single-use authorization issued after Passkey re-auth
REAUTH_GRANT_TTL_MINUTES=5

# Password login rate limiting
PASSWORD_LOGIN_RATE_LIMIT_MAX=5
PASSWORD_LOGIN_RATE_LIMIT_WINDOW_MINUTES=1

# Business-tracking deadlines only — no auto-release tied to these
DELIVERY_DEADLINE_DAYS=7
INSPECTION_DEADLINE_DAYS=3

# Mock Payment Provider HMAC secret (shared secret to sign/verify webhook callbacks)
# Generate your own: openssl rand -base64 32
MOCK_PAYMENT_HMAC_SECRET=change-me-to-a-random-32-byte-base64-secret

# Optional bootstrap administrator. Production creates one only when BOTH are set.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-one-time-password
