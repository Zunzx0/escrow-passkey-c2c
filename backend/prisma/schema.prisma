datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =====================================================================
// Schema follows BA.md section 18 ("Quy tắc dữ liệu chính cần giữ khi
// triển khai") exactly. Do not add tables/fields/enums that aren't
// grounded in BA.md / ke-hoach-du-an-escrow-passkey.md without checking
// back against those documents first.
//
// Money fields hold whole VND (đồng) as Int — VND has no smaller
// fractional unit, so field names do NOT carry a "Cents" suffix.
// =====================================================================

// Stage 4 review (2026-09-18): renamed from BUYER — BA.md §2.1/§2.2 define
// "buyer"/"seller" as PER-TRANSACTION roles (transaction.buyer_id /
// transaction.seller_id / listing.seller_id), never as a fixed account
// identity. The same account creates listings (acting as seller for
// those) AND creates transactions on other people's listings (acting as
// buyer for those) — BA.md does not model a separate seller account
// role. Calling the account-level role "BUYER" was misleading and would
// have collided badly with Stage 5's seller-acknowledgement checks.
// MEMBER = any regular (non-admin) account; buyer/seller-ness is always
// derived from the specific Transaction/Listing row, never from this
// field.
enum UserRole {
  MEMBER
  ADMIN // never a party to a transaction, never holds a wallet balance for it
}

// Account is not usable for sensitive operations until a first Passkey
// is registered (BA.md §3.3, §19).
enum AccountStatus {
  PENDING_PASSKEY
  ACTIVE
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  displayName   String?
  role          UserRole      @default(MEMBER)
  accountStatus AccountStatus @default(PENDING_PASSKEY)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  passkeyCredentials   PasskeyCredential[]
  sessions             Session[]
  wallet               Wallet?
  listings             Listing[]
  transactionsAsBuyer  Transaction[]    @relation("BuyerTransactions")
  transactionsAsSeller Transaction[]    @relation("SellerTransactions")
  disputesOpened       Dispute[]        @relation("DisputeOpener")
  disputesResolved     Dispute[]        @relation("DisputeResolver")
  authChallenges       AuthChallenge[]
  reauthGrants         ReauthGrant[]
  paymentRequests      PaymentRequest[]
  securityEvents       SecurityEvent[]
}

// One user may register several credentials (one per device/authenticator).
// Server stores only the public key — the private key never leaves the
// authenticator (kiến thức §6).
model PasskeyCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique // base64url of the authenticator's rawId
  publicKey    Bytes
  counter      BigInt    @default(0) // risk signal only — see kiến thức §9, BA.md §18
  transports   String[]
  deviceType   String?
  backedUp     Boolean   @default(false)
  aaguid       String?
  nickname     String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  securityEvents SecurityEvent[]

  @@index([userId])
}

// Server-side session — cookie only carries a random opaque token, no JWT.
// Password login and Passkey login both create this same session type
// (BA.md §3.2).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

enum ChallengePurpose {
  REGISTER
  LOGIN
  REAUTH
}

// WebAuthn challenge — random, single-use, expiring, bound to a purpose
// (BA.md §6). `context` holds the server-rebuilt trusted context for
// REAUTH challenges (action/transaction/amount/etc.), re-checked after
// verification before a grant is issued. `challenge` is unique as a
// defense-in-depth belt-and-suspenders check (collision should be
// cryptographically impossible; a duplicate would indicate a broken RNG).
//
// `usedAt` is set both when a challenge is legitimately consumed by a
// successful verification AND when a newer challenge for the same
// (userId, purpose) supersedes it (Stage 2 review: at most one active
// challenge per user+purpose at a time) — either way it means "this
// challenge can never be used again."
//
// Periodic cleanup of expired/unused rows is still deferred — see
// roadmap step 23 ("WebAuthn Challenge Rate Limiting + Cleanup"). Issuance
// rate limiting itself IS implemented (Stage 2 review), in
// auth.controller.ts, reusing utils/rateLimit.ts.
model AuthChallenge {
  id        String           @id @default(cuid())
  userId    String? // nullable: discoverable/usernameless LOGIN challenges aren't bound to a user yet
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   ChallengePurpose
  challenge String           @unique
  context   Json?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum SecurityEventSeverity {
  INFO
  WARNING
  CRITICAL
}

// Account/credential-level security signals — deliberately separate from
// AuditLog, which is the money-moving hash chain scoped to a Transaction
// or PaymentRequest. A signCount anomaly (kiến thức §9) is a property of
// a credential/session, not of any specific transaction, so it does not
// belong in AuditLog. NEVER store challenge values, grant tokens, or
// other secrets in `metadata` — it exists to be readable evidence
// (queryable, screenshot-able for Chương 3), not a secret store.
model SecurityEvent {
  id                  String                @id @default(cuid())
  userId              String?
  user                User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  passkeyCredentialId String?
  passkeyCredential   PasskeyCredential?    @relation(fields: [passkeyCredentialId], references: [id], onDelete: SetNull)
  eventType           String
  severity            SecurityEventSeverity
  metadata            Json
  createdAt           DateTime              @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

enum GrantAction {
  RELEASE
  ADJUDICATE
  ADD_PASSKEY
  REMOVE_PASSKEY
  CHANGE_PASSWORD
}

enum GrantDecision {
  REFUND
  RELEASE
}

// Scoped one-time authorization issued after a successful Passkey
// re-auth with UV (BA.md §4-§6, §21). Server stores only a hash of the
// token. Admin grants additionally bind a dispute + exact decision.
model ReauthGrant {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String         @unique
  action        GrantAction
  transactionId String?
  transaction   Transaction?   @relation(fields: [transactionId], references: [id])
  disputeId     String?
  dispute       Dispute?       @relation(fields: [disputeId], references: [id])
  decision      GrantDecision?
  context       Json // canonical context bound at issuance; re-checked at consumption
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime       @default(now())

  @@index([userId])
}

// A listing is a single, unique item (BA.md §18: "tin đăng đơn chiếc").
// status/version exist ONLY to guarantee "one successful LOCK per
// listing" — they are not a general listing lifecycle.
//
// TODO (do not implement until listing lifecycle is decided): `SOLD`
// exists in this enum because BA.md §18 names it, but no code may ever
// transition a listing to SOLD, or back to AVAILABLE after a
// transaction reaches a terminal state, until that lifecycle is
// explicitly chốt in BA.md/Chương 2. The only transition to implement
// for now is AVAILABLE -> LOCKED at LOCK time (Stage 4).
enum ListingStatus {
  AVAILABLE
  LOCKED
  SOLD
}

model Listing {
  id          String        @id @default(cuid())
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  price       Int // whole VND
  status      ListingStatus @default(AVAILABLE)
  version     Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  images       ListingImage[]
  transactions Transaction[]
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)
}

// Money-holding wallet. Every user has exactly one; there is exactly one
// additional Escrow wallet (userId null, isEscrow true). "Exactly one
// Escrow wallet" is enforced by a REAL PostgreSQL partial unique index
// (migration 002_wallet_single_escrow, not just a Prisma-level
// assumption) — see backend/scripts/verify-single-escrow-wallet.ts for
// a standalone check that a second attempt is rejected by the database.
// available/locked are tracked separately (BA.md §18).
model Wallet {
  id                    String   @id @default(cuid())
  userId                String?  @unique
  user                  User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isEscrow              Boolean  @default(false)
  availableBalance      Int      @default(0) // whole VND
  lockedBalance         Int      @default(0) // whole VND
  version               Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  entries WalletEntry[]
}

enum WalletEntryType {
  TOPUP
  LOCK
  RELEASE
  REFUND
}

// Balanced record of every balance change (BA.md §18). A single
// financial operation can create several entries (e.g. LOCK touches
// both the buyer wallet and the Escrow wallet), so the uniqueness guard
// for idempotency is composite, not on idempotencyKey alone.
//
// Exactly one of transactionId / paymentRequestId must be set (a LOCK/
// RELEASE/REFUND entry references a Transaction; a TOPUP entry
// references a PaymentRequest — top-up is NOT an escrow Transaction).
// Enforced by a CHECK constraint in migration
// 003_payment_audit_exactly_one_subject.
model WalletEntry {
  id                        String          @id @default(cuid())
  walletId                  String
  wallet                    Wallet          @relation(fields: [walletId], references: [id])
  transactionId             String?
  transaction               Transaction?    @relation(fields: [transactionId], references: [id])
  paymentRequestId          String?
  paymentRequest            PaymentRequest? @relation(fields: [paymentRequestId], references: [id])
  deltaAvailable             Int // whole VND, signed
  deltaLocked                Int // whole VND, signed
  availableBalanceAfter      Int // whole VND
  lockedBalanceAfter         Int // whole VND
  entryType                  WalletEntryType
  idempotencyKey              String
  requestFingerprint          String
  createdAt                   DateTime        @default(now())

  @@unique([idempotencyKey, walletId])
  @@index([walletId])
  @@index([transactionId])
  @@index([paymentRequestId])
}

// Core transaction state machine — EXACTLY 8 states / 9 transitions per
// BA.md §7. Do not add CANCELLED / AUTO_RELEASE / PARTIAL_REFUND or any
// other status/transition without updating BA.md first.
enum TransactionStatus {
  CREATED
  SECURED
  SHIPPING
  WAIT_CONFIRM
  DISPUTED
  COMPLETED
  RELEASED
  REFUNDED
}

enum EscrowStatus {
  NONE
  LOCKED
  FROZEN
  RELEASED
  REFUNDED
}

model Transaction {
  id       String @id @default(cuid())
  buyerId  String
  buyer    User   @relation("BuyerTransactions", fields: [buyerId], references: [id])
  sellerId String
  seller   User   @relation("SellerTransactions", fields: [sellerId], references: [id])

  // listingId is intentionally NOT unique — several CREATED transactions
  // may reference the same listing before one of them locks it
  // successfully (BA.md §8.1, §18).
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  amount       Int // whole VND
  status       TransactionStatus @default(CREATED)
  escrowStatus EscrowStatus      @default(NONE)
  version      Int               @default(0)

  deliveryDeadline   DateTime?
  inspectionDeadline DateTime?
  sellerAckAt        DateTime? // business-event timestamp, NOT a state (BA.md §8.3)
  shippedAt          DateTime?
  receivedAt         DateTime? // buyer confirmed receipt -> WAIT_CONFIRM
  completedAt        DateTime? // buyer RELEASE -> COMPLETED
  releasedAt         DateTime? // admin adjudication -> RELEASED
  refundedAt         DateTime? // admin adjudication -> REFUNDED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  walletEntries WalletEntry[]
  dispute       Dispute?
  reauthGrants  ReauthGrant[]
  auditLogs     AuditLog[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([listingId])
  @@index([status])
}

enum DisputeInternalStatus {
  OPEN
  UNDER_REVIEW
  NEED_MORE_EVIDENCE
  RESOLVED
}

enum DisputeDecision {
  REFUND
  RELEASE
}

// One transaction has at most one dispute (BA.md §18: FK + UNIQUE).
model Dispute {
  id             String                @id @default(cuid())
  transactionId  String                @unique
  transaction    Transaction           @relation(fields: [transactionId], references: [id])
  openedById     String
  openedBy       User                  @relation("DisputeOpener", fields: [openedById], references: [id])
  reason         String
  status         DisputeInternalStatus @default(OPEN)
  decision       DisputeDecision?
  resolvedById   String?
  resolvedBy     User?                 @relation("DisputeResolver", fields: [resolvedById], references: [id])
  resolutionNote String?
  createdAt      DateTime              @default(now())
  resolvedAt     DateTime?

  reauthGrants ReauthGrant[]
}

// Hash chain (BA.md §16-17). Canonicalization rules for hashing live in
// the audit service, not here.
//
// Exactly one of transactionId / paymentRequestId must be set — each
// subject (an escrow Transaction, or a top-up PaymentRequest) keeps its
// own independent chain with its own seqNo starting at 1. Enforced by a
// CHECK constraint in migration 003_payment_audit_exactly_one_subject.
model AuditLog {
  id               String          @id @default(cuid())
  transactionId    String?
  transaction      Transaction?    @relation(fields: [transactionId], references: [id])
  paymentRequestId String?
  paymentRequest   PaymentRequest? @relation(fields: [paymentRequestId], references: [id])
  seqNo            Int
  actorId          String?
  action           String
  data             Json
  prevHash         String
  currentHash      String
  createdAt        DateTime        @default(now())

  @@unique([transactionId, seqNo])
  @@unique([paymentRequestId, seqNo])
  @@index([transactionId])
  @@index([paymentRequestId])
}

// Mock Payment Provider top-up lifecycle (kiến thức §32-41, BA.md §11
// "Xác thực webhook"). Never a synchronous `balance += amount`. A
// top-up is deliberately NOT modeled as an escrow Transaction — it has
// its own identity, its own idempotency key (protects the *creation* of
// the request itself, separate from WalletEntry's idempotency guard on
// the resulting financial effect), and its own audit/wallet-entry
// references (see WalletEntry, AuditLog above).
enum PaymentRequestStatus {
  PENDING
  SUCCEEDED
  FAILED
  TIMEOUT
}

model PaymentRequest {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id])
  amount            Int // whole VND
  status            PaymentRequestStatus @default(PENDING)
  idempotencyKey    String               @unique // guards duplicate request *creation* (double-click/retry)
  providerReference String               @unique // the Mock Provider's own identifier for this request
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  callbacks     PaymentCallback[]
  walletEntries WalletEntry[]
  auditLogs     AuditLog[]
}

// Every callback received is logged, including invalid/forged ones, so
// the "Callback giả" and "Duplicate webhook" test cases (ke-hoach §19)
// have evidence to check. `providerEventId` identifies one specific
// callback delivery (the provider's event/delivery id) so retried or
// duplicate deliveries of the *same* event can be recognized as such,
// distinct from two genuinely different callbacks for the same request
// (e.g. PENDING then SUCCEEDED).
model PaymentCallback {
  id                String               @id @default(cuid())
  paymentRequestId  String
  paymentRequest    PaymentRequest       @relation(fields: [paymentRequestId], references: [id])
  providerEventId   String
  reportedStatus    PaymentRequestStatus
  signatureValid    Boolean
  rawPayload        Json
  receivedAt        DateTime             @default(now())
  processedAt       DateTime?

  @@unique([paymentRequestId, providerEventId])
  @@index([paymentRequestId])
}
