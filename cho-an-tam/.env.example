# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

PORT=3000

# ---------------------------------------------------------------------------
# Cơ sở dữ liệu
#
# Không đặt DATABASE_URL -> SQLite tại DB_PATH (mặc định data/escrow.db), dùng cho máy dev.
# Đặt DATABASE_URL       -> PostgreSQL (Supabase khi triển khai). Bảng nằm ở schema `app`,
#                           Mock Provider ở schema `mock_provider`; máy chủ tự tạo khi khởi động.
#
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (cổng 5432,
# chạy được qua IPv4). Chuỗi này chứa MẬT KHẨU cơ sở dữ liệu: chỉ đặt ở máy chủ API (Railway
# Variables), không bao giờ đặt ở Vercel, không commit.
#
# PostgreSQL cục bộ không có TLS: thêm ?sslmode=disable vào cuối chuỗi, hoặc đặt PGSSL=disable.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.xxxx:<mật-khẩu>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# DB_PATH=data/escrow.db
# PG_POOL_MAX=10

# ---------------------------------------------------------------------------
# Tách giao diện (Vercel) khỏi API (Railway)
#
# CORS_ORIGIN: danh sách origin được phép gọi API từ trình duyệt, cách nhau bằng dấu phẩy, so khớp
# CHÍNH XÁC. Để trống khi giao diện và API cùng một máy chủ (máy dev, Render).
# SERVE_FRONTEND=0: máy chủ API không phục vụ thư mục public/ nữa (giao diện đã ở Vercel).
# ---------------------------------------------------------------------------
# CORS_ORIGIN=https://enclave.id.vn
# SERVE_FRONTEND=0

# ---------------------------------------------------------------------------
# WebAuthn / Passkeys
#
# Bốn thông số dưới đây PHẢI được cố định ngay từ đầu đợt thực nghiệm và ghi vào
# báo cáo: URL truy cập, origin, RP ID, cùng trình duyệt và bộ xác thực đã dùng.
# Đây là thứ dễ làm một buổi demo Passkey chết nhất — lúc thì localhost, lúc thì
# địa chỉ IP, lúc thì tên miền khác, và chữ ký thu được ở lần đo trước không còn
# hợp lệ ở lần sau.
#
# Mở trình duyệt ĐÚNG địa chỉ ghi ở WEBAUTHN_ORIGIN (không dùng 127.0.0.1).
# ---------------------------------------------------------------------------
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# JWT — sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Máy chủ TỪ CHỐI KHỞI ĐỘNG nếu biến này còn là giá trị mẫu hoặc ngắn dưới 32 ký tự. Chạy
# tiếp với khoá ký mặc định nguy hiểm hơn là dừng hẳn: khi đó mọi mã phiên đều giả mạo được
# mà hệ thống vẫn trông như đang chạy bình thường.
JWT_SECRET=CHANGE_ME_RUN_THE_COMMAND_ABOVE
ACCESS_TOKEN_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Mock Payment Provider — chữ ký webhook nạp tiền (HMAC-SHA256)
#
# Sinh bằng cùng lệnh ở trên. Máy chủ TỪ CHỐI KHỞI ĐỘNG nếu biến này còn là giá trị mẫu
# hoặc ngắn dưới 32 ký tự: thiếu nó thì verifyProviderSignature() luôn từ chối một cách an
# toàn (webhook nạp tiền không chạy được), nhưng vẫn coi là lỗi khởi động để không ai mất
# công tìm hiểu vì sao mọi lần nạp tiền đều bị 401.
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_RUN_THE_COMMAND_ABOVE

# ---------------------------------------------------------------------------
# Worker đối soát thanh toán (Payment Reconciliation)
#
# Chạy định kỳ trong máy chủ, hỏi Mock Provider về các yêu cầu nạp tiền còn PENDING. Không
# bao giờ coi "vẫn PENDING" hay "không hỏi được provider" là thất bại. Đặt 0 để tắt.
# RECONCILE_MIN_AGE_SECONDS: bỏ qua yêu cầu mới tạo, cho webhook một khoảng để tới trước.
# Chạy tay một lượt: node scripts/reconcile.js [--min-age=0] [--id=<paymentId>]
# ---------------------------------------------------------------------------
RECONCILE_INTERVAL_SECONDS=60
RECONCILE_MIN_AGE_SECONDS=30

# Độ trễ mô phỏng (ms) của API truy vấn trạng thái ở Mock Provider. Bộ kiểm thử đối soát tự
# tăng giá trị này cho từng process worker để tạo cuộc đua worker–webhook có thật.
MOCK_PROVIDER_LATENCY_MS=0
# Kho trạng thái riêng của Mock Provider — mặc định <DB_PATH bỏ đuôi .db>.mock-provider.db
# MOCK_PROVIDER_DB_PATH=

# "Trang thanh toán" của Mock Provider tại /mock-provider/* — nơi người dùng chọn kết quả
# thanh toán trong buổi demo, rồi provider gửi webhook đã ký về /api/payments/webhook. Đây là
# sandbox của provider mô phỏng: nó KHÔNG chạm ví; mọi thay đổi số dư vẫn đi qua webhook và
# applyProviderResult. Đặt 0 để tắt khi không cần demo nạp tiền bằng giao diện.
MOCK_PROVIDER_CHECKOUT=1
# Địa chỉ provider gửi webhook về (mặc định http://127.0.0.1:<PORT>/api/payments/webhook)
# PAYMENT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Dọn challenge WebAuthn đã hết hạn / đã dùng
#
# Chỉ là vệ sinh dữ liệu — mọi quyết định an toàn vẫn dựa trên expires_at, used_at, purpose
# của bản ghi. Challenge còn hiệu lực và chưa dùng không bao giờ bị xoá. GRACE giữ lại bản ghi
# vừa hết hạn/vừa dùng để lần phát lại trong khoảng đó vẫn nhận đúng mã lỗi. Đặt 0 để tắt.
# Chạy tay một lượt: node scripts/cleanup-challenges.js [--grace=<giây>]
# ---------------------------------------------------------------------------
CHALLENGE_CLEANUP_INTERVAL_SECONDS=600
CHALLENGE_CLEANUP_GRACE_SECONDS=3600

# ---------------------------------------------------------------------------
# Thời hạn của challenge và của phiếu uỷ quyền (giây)
#
# Hai giá trị này nằm ở cấu hình chứ không nằm rải rác trong mã, để môi trường
# thực nghiệm rút ngắn được nhằm kiểm kịch bản hết hạn mà không phải chờ thật.
# Nếu rút ngắn thì PHẢI ghi rõ trong báo cáo rằng đó là cấu hình test.
#
#   giá trị dùng như thật : CHALLENGE_TTL_SECONDS=300  REAUTH_TTL_SECONDS=120
#   giá trị để test hết hạn: CHALLENGE_TTL_SECONDS=5    REAUTH_TTL_SECONDS=3
# ---------------------------------------------------------------------------
CHALLENGE_TTL_SECONDS=300
REAUTH_TTL_SECONDS=120

# Giới hạn tần suất (request/phút/IP/tuyến).
#
# Áp cho: đăng nhập bằng mật khẩu và bằng Passkey, tạo tài khoản, mọi điểm SINH CHALLENGE,
# đổi mật khẩu, quản lý credential, mở tranh chấp và các điểm phân xử của quản trị viên.
# Xô đếm khoá theo MẪU tuyến chứ không theo đường dẫn cụ thể, nên đổi mã giao dịch không
# lách được giới hạn.
RATE_LIMIT_AUTH_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Chỉ dành cho kiểm thử — PHẢI TẮT khi thu kết quả chính thức
#
# FAULT_INJECT chèn một lỗi có chủ đích vào giữa một nghiệp vụ tài chính để chứng minh
# rollback. Dạng "<nghiệp vụ>:<điểm>"; nghiệp vụ là lock | release | admin-refund |
# admin-release, điểm là after-wallet-update | before-status-change | before-audit-log.
#
#   $env:FAULT_INJECT="release:after-wallet-update"; npm start
#   node test/rollback-e2e.js
#
# Khi bật, máy chủ in cảnh báo lớn lúc khởi động và GET /health trả về giá trị đang dùng.
# FAULT_INJECT=

# TRUST_PROXY=1 chỉ bật khi thực sự chạy sau một proxy tin cậy. Bật sẵn thì bất kỳ ai cũng
# tự khai địa chỉ IP qua X-Forwarded-For và vượt qua giới hạn tần suất.
# TRUST_PROXY=1

# ENABLE_HSTS=1 chỉ bật khi đã thực sự chạy HTTPS. Bật nhầm trên HTTP sẽ khoá trình duyệt
# của người dùng khỏi chính trang này trong nhiều tháng.
# ENABLE_HSTS=1

# Số dư demo cấp cho người mua khi HOÀN TẤT đăng ký, tức là sau khi đã đăng ký Passkey (VND).
# Giữ nguyên giá trị này trong suốt đợt thực nghiệm để số dư trước/sau của mọi lần đo so được với nhau.
DEMO_BUYER_INITIAL_BALANCE=5000000

# ---------------------------------------------------------------------------
# Không có biến môi trường nào cấp quyền.
#
#   Người mua     : đăng ký gồm hai bước — tạo tài khoản bằng mật khẩu, rồi đăng ký
#                   Passkey (bắt buộc, userVerification = required). Chỉ sau bước thứ
#                   hai tài khoản mới hoạt động và mới có ví.
#   Người bán     : gửi yêu cầu ở mục "Mở cửa hàng", quản trị viên duyệt.
#   Quản trị viên : npm run seed:admin -- --username=<tên> tạo tài khoản kèm mật khẩu
#                   tạm; hai bước còn lại (đổi mật khẩu tạm, đăng ký Passkey đầu tiên)
#                   làm trên trình duyệt.
# ---------------------------------------------------------------------------
