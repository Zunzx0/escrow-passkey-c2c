    "test:market": "node test/market-e2e.js",
    "test:security": "node test/security-e2e.js",
    "test:hybrid": "node test/hybrid-e2e.js",
    "test:rollback": "node test/rollback-e2e.js",
    "test:hardening": "node test/hardening-e2e.js",
