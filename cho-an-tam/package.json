    "node": ">=23.4.0"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "sharp": "0.35.5",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "jsdom": "30.1.2"
  }
