    "test:listing-lifecycle": "node test/listing-lifecycle-e2e.js",
    "test:passkey-registration-race": "node test/passkey-registration-race-e2e.js",
    "test:topup-concurrency": "node test/topup-concurrency-e2e.js",
    "test:manual-transaction-amount": "node test/manual-transaction-amount-e2e.js",
    "test:topup-idempotency": "node test/topup-idempotency-e2e.js",
    "test:admin-provenance": "node test/admin-provenance-e2e.js",
    "test:all": "node test/e2e.js && node test/market-e2e.js && node test/security-e2e.js && node test/hybrid-e2e.js && node test/payment-e2e.js && node test/reconcile-e2e.js",
