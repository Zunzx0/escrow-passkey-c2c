    "test:counter": "node test/counter-e2e.js",
    "test:cleanup": "node test/cleanup-e2e.js",
    "test:invariants": "node test/invariants-unit.js",
    "test:notifications": "node test/notification-e2e.js",
    "test:checkout": "node test/checkout-e2e.js",
    "test:dispute-race": "node test/dispute-race-e2e.js",
    "test:username-enumeration": "node test/username-enumeration-e2e.js",
