    "test:core": "node test/e2e.js",
    "test:market": "node test/market-e2e.js",
    "test:security": "node test/security-e2e.js",
    "test:hybrid": "node test/hybrid-e2e.js",
    "test:rollback": "node test/rollback-e2e.js",
    "test:hardening": "node test/hardening-e2e.js",
    "test:payment": "node test/payment-e2e.js",
    "test:reconcile": "node test/reconcile-e2e.js",
    "test:counter": "node test/counter-e2e.js",
    "test:cleanup": "node test/cleanup-e2e.js",
    "test:invariants": "node test/invariants-unit.js",
    "test:auth": "node test/auth-migration.js && node --test test/auth-keys.test.js test/auth-mail.test.js && node test/auth-redesign-e2e.js && node test/auth-verification-e2e.js && node test/email-recovery-e2e.js && node test/ui/auth-redesign-ui.js && node test/ui/auth-verification-ui.js && node test/ui/email-recovery-ui.js",
